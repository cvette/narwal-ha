        "zones": {
          "name": "Zones",
          "description": "List of rectangles [x1, y1, x2, y2] in millimetres, two opposite corners each, in the frame of the map image's calibration_points."
        },
        "repeats": {
          "name": "Repeats",
          "description": "How often each zone is cleaned (1 to 3)."
        }
      }
    },
    "reset_consumables": {
      "name": "Reset consumable reminders",
      "description": "Tells the robot that parts were cleaned or replaced, which clears their reminders. Without parts, all due reminders are cleared. The lifetime shown in the Narwal app is kept in Narwal's cloud and does not change.",
      "fields": {
        "config_entry_id": {
          "name": "Robot",
          "description": "The robot whose reminders to clear."
        },
        "items": {
          "name": "Parts",
          "description": "Parts you cleaned or replaced. Leave empty for all due parts."
        }
      }
